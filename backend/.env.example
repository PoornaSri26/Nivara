# Nivara Environment Variables
# Copy this file to .env and fill in the values before running.

# ─────────────────────────────────────────────
#  DATABASE
# ─────────────────────────────────────────────
# Local development (SQLite, no setup required):
DATABASE_URL=sqlite+aiosqlite:///./nivara.db

# Production (PostgreSQL 16 + pgvector):
# DATABASE_URL=postgresql+asyncpg://nivara_user:nivara_secure_password@localhost:5432/nivara_db

# ─────────────────────────────────────────────
#  LLM PROVIDER  (choose one)
# ─────────────────────────────────────────────
# Google Gemini (recommended):
LLM_MODEL_NAME=gemini-1.5-pro
LLM_API_KEY=your-google-ai-studio-api-key-here

# OpenAI:
# LLM_MODEL_NAME=gpt-4o
# LLM_API_KEY=your-openai-api-key-here

EMBEDDING_MODEL_NAME=text-embedding-3-small

# ─────────────────────────────────────────────
#  SAFETY
# ─────────────────────────────────────────────
SAFETY_STRICT_MODE=True
CRISIS_CONFIDENCE_THRESHOLD=0.65

# ─────────────────────────────────────────────
#  MEMORY
# ─────────────────────────────────────────────
DEFAULT_MEMORY_CONFIDENCE_THRESHOLD=0.70
PROPOSED_MEMORY_EXPIRATION_DAYS=14

# ─────────────────────────────────────────────
#  AUTH (future: JWT / OAuth)
# ─────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

